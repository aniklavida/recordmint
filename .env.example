# Copy to .env and fill in every value before running anything.
# Nothing here has a real default — see docs/SPEC.md and docs/ARCHITECTURE.md.

# --- Postgres ---------------------------------------------------------
# Used by apps/web, apps/worker and packages/db (Drizzle) directly.
DATABASE_URL=

# --- Object storage (S3-compatible; MinIO locally, any bucket in prod) -
# packages/storage is the only code that reads these.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# "false" only for a provider that rejects path-style requests (e.g. AWS S3
# with a DNS-resolvable bucket name). MinIO requires path-style: leave unset
# or "true".
S3_FORCE_PATH_STYLE=

# --- Web app ------------------------------------------------------------
# The public base URL is what makes a share link and a link preview correct.
# It must be reachable by anyone you send a link to, not just localhost.
PUBLIC_BASE_URL=
# 32+ random bytes. Signs the session cookie. Never reuse across environments.
SESSION_SECRET=
PORT=

# --- Mail (password reset) ----------------------------------------------
# apps/web/src/lib/mail.ts is the only code that reads these. A reset link
# is a credential — this relay only ever sends it, it never appears in a
# log line or an API response.
SMTP_HOST=
SMTP_PORT=
# "true" only for a relay that expects implicit TLS on connect (commonly
# port 465). Most relays, including port 587, use STARTTLS instead — leave
# this unset or "false" for those.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Transcription (optional; whisper.cpp / faster-whisper, host-only) --
TRANSCRIPTION_ENABLED=
WHISPER_BINARY_PATH=
WHISPER_MODEL=

# --- MinIO bootstrap (infra/compose.yaml only; not read by application code) -
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
